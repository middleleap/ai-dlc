<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageId>MiddleLeap.Shuttle.Worker</PackageId>
    <Version>0.2.0</Version>
    <Authors>MiddleLeap</Authors>
    <Description>Synthetic-only guarded Shuttle render worker with exact SharePoint file verification; tenant qualification required.</Description>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeRuntimeDependencies</TargetsForTfmSpecificBuildOutput>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <Compile Include="../Shuttle.Guards/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../Shuttle.Dataverse/Schema.cs" Link="Shared/Schema.cs" />
    <Compile Include="../Shuttle.Dataverse/StrictWireDecoder.cs" Link="Shared/StrictWireDecoder.cs" />
    <Compile Include="../Shuttle.Dataverse/EmbeddedSourcePolicy.cs" Link="Shared/EmbeddedSourcePolicy.cs" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="IncludeRuntimeDependencies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.Filename)' != 'Microsoft.Xrm.Sdk' and '%(ReferenceCopyLocalPaths.Filename)' != 'Microsoft.Crm.Sdk.Proxy' and '%(ReferenceCopyLocalPaths.Filename)' != 'System.ServiceModel.Http' and '%(ReferenceCopyLocalPaths.Filename)' != 'System.ServiceModel.Primitives'" />
    </ItemGroup>
  </Target>
</Project>

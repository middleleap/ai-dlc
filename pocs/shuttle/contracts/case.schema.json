{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.middleleap.example/shuttle/case/v0.1",
  "title": "Shuttle provisional synthetic case v0.1",
  "description": "One authored case. IDs are deterministic test identifiers, not Dataverse rows. Facts and sources describe a design sample, never accepted bank evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "synthetic",
    "caseId",
    "caseKey",
    "title",
    "role",
    "contentRevision",
    "sourceCutoff",
    "facts",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "shuttle.case.v0.1"
    },
    "synthetic": {
      "const": true
    },
    "caseId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "caseKey": {
      "const": "SHWF-001"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
        }
      ]
    },
    "role": {
      "const": "LFIProvider"
    },
    "contentRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sourceCutoff": {
      "type": "string",
      "format": "date"
    },
    "facts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "value",
          "state",
          "sourceIds",
          "owedOwner"
        ],
        "properties": {
          "key": {
            "enum": [
              "F1",
              "F2",
              "F3",
              "F4",
              "F5",
              "F6",
              "F7"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
              }
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
              }
            ]
          },
          "state": {
            "enum": [
              "DocumentedSample",
              "Partial",
              "Owed"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{2}(?![\\s\\S])"
            },
            "maxItems": 32,
            "uniqueItems": true
          },
          "owedOwner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
              }
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "file",
          "sha256",
          "asOfDate",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}(?![\\s\\S])"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
              }
            ]
          },
          "file": {
            "type": "string",
            "pattern": "^content/sources/[A-Za-z0-9_-]+\\.md(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "asOfDate": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "const": "SYNTHETIC_DESIGN_ONLY"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.middleleap.example/shuttle/proposal/v0.1",
  "title": "Shuttle provisional synthetic Proposal v0.1",
  "description": "Wire contract only. Does not authorize a caller, register an artifact, or imply bank acceptance. Unknown/client-authoritative fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "caseId",
    "expectedContentRevision",
    "requestKey",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "shuttle.proposal.v0.1"
    },
    "kind": {
      "enum": [
        "PackDraft",
        "InspectionComment"
      ]
    },
    "caseId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "expectedContentRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "requestKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PackDraft"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/packDraftPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "InspectionComment"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/commentPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "packDraftPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateRelease",
        "skillRelease",
        "sections"
      ],
      "properties": {
        "templateRelease": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
            }
          ]
        },
        "skillRelease": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
            }
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "text",
              "sourceIds"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
                  }
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
                  }
                ]
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^S[0-9]{2}(?![\\s\\S])"
                },
                "maxItems": 32,
                "uniqueItems": true
              },
              "owedOwner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
                  }
                ]
              }
            },
            "anyOf": [
              {
                "properties": {
                  "sourceIds": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "owedOwner"
                ]
              }
            ]
          }
        }
      }
    },
    "commentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactVersionId",
        "artifactHash",
        "text"
      ],
      "properties": {
        "artifactVersionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*(?![\\s\\S])"
            }
          ]
        },
        "relatedCommentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        }
      }
    }
  }
}

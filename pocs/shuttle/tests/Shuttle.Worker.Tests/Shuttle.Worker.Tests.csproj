<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runs the same source with .NET 10 SDK types; does not execute the net462 sandbox. -->
    <Compile Include="../../src/Shuttle.Worker/*.cs" Link="Worker/%(Filename)%(Extension)" />
    <Compile Include="../../src/Shuttle.Guards/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/Shuttle.Dataverse/Schema.cs" Link="Shared/Schema.cs" />
    <Compile Include="../../src/Shuttle.Dataverse/StrictWireDecoder.cs" Link="Shared/StrictWireDecoder.cs" />
    <Compile Include="../../src/Shuttle.Dataverse/EmbeddedSourcePolicy.cs" Link="Shared/EmbeddedSourcePolicy.cs" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <Content Include="../../fixtures/pack-draft.json" Link="fixtures/pack-draft.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../fixtures/case-alpha.json" Link="fixtures/case-alpha.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Shuttle.Dataverse/fixtures/embedded-sources.json" Link="fixtures/embedded-sources.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
